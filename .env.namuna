# ===========================================================================
#  .env  NAMUNASI  —  serverdagi sozlamalar
# ===========================================================================
#
#  Bu faylni SERVERDA nusxa ko'chirib, nomini `.env` qiling:
#
#      cp .env.namuna .env
#
#  So'ng kerakli qatorlarni tahrirlang. `.env` git'ga KIRMAYDI (.gitignore da),
#  ya'ni har bir serverning o'z sozlamasi bo'ladi va `git pull` uni buzmaydi.
#
#  Mahalliy kompyuterda (ishlab chiqishda) bu fayl KERAK EMAS — hech narsa
#  bo'lmasa, sozlamalar o'zi xavfsiz standart holatga tushadi.
# ===========================================================================


# --- HTTPS ------------------------------------------------------------------
# Sayt HTTPS orqali ochilsa 1 qiling. Shunda:
#   • http:// so'rovlari https:// ga yo'naltiriladi;
#   • session va CSRF cookie'lari faqat himoyalangan ulanishda yuboriladi;
#   • HSTS sarlavhasi qo'shiladi;
#   • Django TLS'ni oldindagi nginx/Cloudflare tugatganini X-Forwarded-Proto
#     sarlavhasidan biladi.
#
# DIQQAT: sertifikat hali yo'q bo'lsa 1 qilmang — sayt ochilmay qoladi.
DJANGO_HTTPS=1

# HSTS muddati (soniya). Birinchi kunlari kichik qiymat bilan sinab ko'ring
# (3600 = 1 soat), hammasi joyida bo'lsa 31536000 (1 yil) ga qo'ying.
# Standart: 31536000
#DJANGO_HSTS_SECONDS=3600

# Poddomenlarga ham tarqalsinmi (standart: 1).
# Agar biror poddomen HTTPS'siz ishlasa — 0 qiling.
#DJANGO_HSTS_SUBDOMAINS=1

# Brauzerlarning preload ro'yxatiga topshirish uchun. ORQAGA QAYTARISH
# JUDA QIYIN — faqat sayt uzoq vaqt barqaror HTTPS'da ishlagach yoqing.
#DJANGO_HSTS_PRELOAD=0

# HTTPS'ga majburiy yo'naltirishni o'chirish kerak bo'lsa (masalan, nginx
# buni o'zi qilsa) — 0 qiling. Standart: 1
#DJANGO_SSL_REDIRECT=1


# --- Maxfiy kalit -----------------------------------------------------------
# Bo'sh qoldirsangiz, sayt birinchi ishga tushganda `.secret_key` faylini
# o'zi yaratadi — bu ham xavfsiz va hech narsa qilish shart emas.
# Bir nechta serverda bitta sessiya ishlashi kerak bo'lsagina shu yerga
# qo'lda yozing (yangi kalit yaratish: `python -c "import secrets,string;
# print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(64)))"`).
#DJANGO_SECRET_KEY=


# --- Domenlar ---------------------------------------------------------------
# Standart ro'yxat settings.py da yozilgan (aniko.uz, texnoedu.uz, ...).
# Yangi domen qo'shilsa shu yerda vergul bilan sanang — kodga tegish shart emas.
#DJANGO_ALLOWED_HOSTS=aniko.uz,www.aniko.uz,localhost,127.0.0.1
#DJANGO_CSRF_TRUSTED_ORIGINS=https://aniko.uz,https://www.aniko.uz


# --- Baza -------------------------------------------------------------------
# Bazani boshqa joyda saqlash kerak bo'lsa (masalan, `git pull` tegmaydigan
# jildda) — to'liq yo'lni yozing. Standart: loyiha ildizidagi db.sqlite3
#DJANGO_DB_PATH=/var/lib/beshbarmoq/db.sqlite3


# --- Nosozlikni tuzatish ----------------------------------------------------
# SERVERDA HECH QACHON 1 QILMANG: xato sahifalari kod va sozlamalarni
# ko'rsatib qo'yadi. Faqat mahalliy tekshiruv uchun.
#DJANGO_DEBUG=0
